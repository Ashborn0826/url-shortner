# URL Shortener backend — example env vars for local dev
#
# When running with `docker compose up -d` from infra/docker-compose.yml,
# the database and redis hostnames are the service names (postgres, redis),
# not localhost. To run the API in the same docker network, point at those.
# To run the API on the host (separate from docker-compose), keep localhost.
DATABASE_URL=postgresql+asyncpg://urlshort:urlshort@localhost:5432/urlshort
REDIS_URL=redis://localhost:6379/0

# Rate limit on POST /api/urls (per IP)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Cache-aside TTL for GET /{short_code}
CACHE_TTL_SECONDS=3600

# Short-code length (default 7; range: 1-32)
SHORT_CODE_LENGTH=7

# Used to build short_url in API responses
API_HOST=http://localhost:8000

# CORS allow-list for the React frontend (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Set to true to log all SQL queries (noisy; dev only)
DEBUG=false